# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Steam OpenID return_to 콜백의 베이스 URL (서버 전용, 런타임에 읽음)
# 미설정 시 요청 origin을 사용한다. 리버스 프록시 뒤라면 반드시 설정할 것.
APP_BASE_URL=http://localhost:3000

# Secret used to sign the session cookie (any random 32+ char string)
SESSION_SECRET=

# 선택: Stage 1 추천 검증용 데이터 수집 (본인이 대시보드에서 동의한 경우에만 기록)
# 켜려면 1로 설정하고, 가명화용 전용 salt(16자 이상, 교체하지 말 것)를 함께 넣어야 한다.
INSTRUMENTATION_ENABLED=
INSTRUMENTATION_SALT=
